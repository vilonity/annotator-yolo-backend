# Pull-mode training worker (optional) — set both to let this server fetch
# training jobs from the central Annotator API (outbound-only, works behind
# NAT — no tunnels or port forwarding). Generate the token in the web app:
# account settings -> "Локальный воркер обучения".
ANNOTATOR_API_URL=
ANNOTATOR_WORKER_TOKEN=
# Set to false only if the central API uses a self-signed certificate.
ANNOTATOR_API_VERIFY_TLS=true

# RunPod (optional) — required only when training jobs run on RunPod GPUs.
# Leave RUNPOD_ENABLED unset/false to run inference-only locally.
RUNPOD_ENABLED=false
RUNPOD_API_KEY=
RUNPOD_NETWORK_VOLUME_NAME=annotator-training-vol
RUNPOD_VOLUME_SIZE_GB=100

# S3-compatible access to the RunPod NetworkVolume (volume id = bucket name).
# Use the datacenter-specific endpoint, e.g. https://s3api-us-il-1.runpod.io
RUNPOD_S3_ENDPOINT_URL=
RUNPOD_S3_ACCESS_KEY_ID=
RUNPOD_S3_SECRET_ACCESS_KEY=
RUNPOD_NETWORK_VOLUME_ID=
# Optional — defaults to the region inferred from the endpoint URL, or us-east-1.
RUNPOD_S3_REGION=
